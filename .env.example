APP_HOST=127.0.0.1
APP_PORT=8000
LOG_LEVEL=INFO
DATABASE_URL=postgresql+asyncpg://fraud:fraud@localhost:5432/fraud
HEALTH_TIMEOUT_SECONDS=2

RABBIT_URL=amqp://guest:guest@localhost:5672/
TASKS_EXCHANGE=tasks
TASKS_QUEUE=tasks
QUEUE_MAX_LENGTH=100
MAX_DELIVERIES=3
RETRY_BASE_SECONDS=0.5
PUBLISH_TIMEOUT_SECONDS=1

MLFLOW_TRACKING_URI=http://localhost:5000
MLFLOW_MODEL_NAME=FraudDetectionModel
MLFLOW_MODEL_ALIAS=champion
PREDICTION_THRESHOLD=0.5

WORKER_HOST=127.0.0.1
WORKER_PORT=8001
WORKER_CONCURRENCY=4
INFERENCE_SECONDS=0.2
WORKER_GRACEFUL_TIMEOUT=30

SOURCE_MIN_BACKOFF_SECONDS=0.01
SOURCE_MAX_BACKOFF_SECONDS=0.5
